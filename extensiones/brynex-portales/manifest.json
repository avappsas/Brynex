{
  "manifest_version": 3,
  "name": "BryNex Portales",
  "version": "1.10.0",
  "description": "Hace los trámites de afiliación de BryNex en los portales de las EPS (S.O.S., Sanitas) con la sesión que la persona abre en su propio navegador.",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://centralaplicaciones.sos.com.co/*",
    "https://www.epssanitas.com/*",
    "https://epssanitas.com/*",
    "https://validate.perfdrive.com/*",
    "https://boxalud.emssanareps.co/*",
    "https://virtual.comfenalcovalle.com.co/*",
    "https://authcomfeempresasprod.web.app/*",
    "https://afiliaciones.sucursalcomfandi.com/*",
    "https://iam.comfandi.com.co/*",
    "https://brynex.co/*",
    "https://www.brynex.co/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://brynex.co/*", "https://www.brynex.co/*", "http://localhost:8000/*"],
      "js": ["puente.js"],
      "run_at": "document_start"
    }
  ]
}
