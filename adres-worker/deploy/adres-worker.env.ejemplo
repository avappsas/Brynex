# Copiar a /etc/brynex/adres-worker.env con permisos 0640 root:www-data.
# NO commitear el archivo real: lleva el token.
#
#   install -d -m 0750 -o root -g www-data /etc/brynex
#   install -m 0640 -o root -g www-data adres-worker.env.ejemplo /etc/brynex/adres-worker.env
#
# ADRES_WORKER_TOKEN debe ser IDÉNTICO al del .env de Laravel.
# Generar uno con:  openssl rand -hex 24

ADRES_WORKER_TOKEN=cambiar-por-el-token-real
ADRES_WORKER_PUERTO=8801

# Loopback, siempre. El worker puede consultar el historial de salud de
# cualquier cédula: no debe quedar accesible desde la red.
ADRES_WORKER_HOST=127.0.0.1

ADRES_HEADLESS=true
ADRES_MAX_INTENTOS=3

# Cuánto espera una consulta a que alguien responda el código antes de soltarla.
ADRES_TTL_SESION_MS=720000
